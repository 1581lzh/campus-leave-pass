# 校园请假通行系统环境变量样例
# 复制为 .env 后填写；.env 权限必须为 0600，且不要提交到仓库。
# 用法（本地开发）：set -a; . ./.env; set +a; make run
# systemd 部署时由 EnvironmentFile=/opt/leavepass/.env 读取。

# ---------------------------------------------------------------------------
# 必填：密钥（至少 16 字节）
# 生成：openssl rand -base64 32
# 轮换 SESSION_SECRET 会使 CSRF/二维码/重置限流键失效，但不会撤销已登录会话；
# 强制下线请用个人资料页“退出其他设备”或改密码。
# 轮换 REGISTRATION_CODE_SECRET 会使全部注册码失效。
# ---------------------------------------------------------------------------
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
REGISTRATION_CODE_SECRET=CHANGE_ME_REGISTRATION_CODE_SECRET

# ---------------------------------------------------------------------------
# 管理员初始化
# ADMIN_INITIAL_PHONE 仅首次启动（库内无管理员）时必填，11 位手机号；
# 已有管理员时忽略。缺失会导致首次启动失败。
# ADMIN_INITIAL_NAME 默认 LOLPK；ADMIN_INITIAL_PASSWORD 默认 AA（1–19 字符）。
# seed 幂等：不会重置已存在管理员的密码。
# ---------------------------------------------------------------------------
ADMIN_INITIAL_PHONE=CHANGE_ME_ADMIN_PHONE
ADMIN_INITIAL_NAME=LOLPK
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ---------------------------------------------------------------------------
# 可选：应用地址与监听
# APP_BASE_URL 用于二维码与绝对链接，必须是外部可访问的 http(s) 地址。
# 本地开发可改为 http://127.0.0.1:8080。
# APP_LISTEN 默认 127.0.0.1:8080，生产由 nginx 反代，不要直接对外暴露。
# ---------------------------------------------------------------------------
APP_BASE_URL=https://leave.lolpk.icu
APP_LISTEN=127.0.0.1:8080

# ---------------------------------------------------------------------------
# 可选：数据库
# DB_PATH 默认 leavepass.db（相对工作目录）；启动时自动迁移并 chmod 0600。
# 生产建议 /opt/leavepass/leavepass.db（目录需对服务用户可写）。
# ---------------------------------------------------------------------------
DB_PATH=leavepass.db

# ---------------------------------------------------------------------------
# 可选：校园楼栋（逗号分隔），作为社区老师选择负责楼栋的候选。
# ---------------------------------------------------------------------------
CAMPUS_BUILDINGS=1栋,2栋,21栋

# ---------------------------------------------------------------------------
# 可选：Cookie 与日志
# APP_INSECURE_COOKIES=1 仅用于本地 HTTP 调试（Cookie 不带 Secure）；
# 生产必须留空或设为 0。
# LOG_LEVEL 可选 debug / info / warn / error，默认 info。
# ---------------------------------------------------------------------------
APP_INSECURE_COOKIES=0
LOG_LEVEL=info

# 建议显式指定时区（业务日期边界固定按 Asia/Shanghai 计算）。
TZ=Asia/Shanghai
